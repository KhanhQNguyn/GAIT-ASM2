def cycle_ai_config(current_key, direction=1):
    idx = AI_CONFIG_KEYS_ORDER.index(current_key)
    idx = (idx + direction) % len(AI_CONFIG_KEYS_ORDER)
    return AI_CONFIG_KEYS_ORDER[idx]
